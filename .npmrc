# Supply chain hardening. Needs npm 12, which package.json's devEngines enforces.

# Cooldown: only resolve versions published at least 7 days ago, so a
# compromised release has time to be caught and pulled before it lands here.
min-release-age=7

# Dependency install scripts are blocked by default in npm 12 unless listed in
# package.json's allowScripts. Strict turns an unreviewed script from a warning
# into a failed install, so a new one cannot slip by in the output.
# Review with `npm approve-scripts --allow-scripts-pending`.
strict-allow-scripts=true

# A typo in this file is an error rather than a warning, so a misspelled key
# cannot quietly switch the settings above off.
strict-npmrc=true
